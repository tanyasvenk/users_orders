{
  "info": {
    "name": "Users_Orders_API_Tests",
    "description": "Postman collection для тестирования Users и Orders сервисов напрямую и через API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User - Success",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\"email\": \"test1@example.com\", \"password\": \"Password123\", \"name\": \"Test User\"}"},
        "url": {"raw":"{{USERS_URL}}/v1/users/register","host":["{{USERS_URL}}"],"path":["v1","users","register"]}
      },
      "event":[{"listen":"test","script":{"exec":["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"]}}]
    },
    {
      "name": "Register User - Success (Via Gateway)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\"email\": \"test2@example.com\", \"password\": \"Password123\", \"name\": \"Test User\"}"},
        "url": {"raw":"{{GATEWAY_URL}}/v1/users/register","host":["{{GATEWAY_URL}}"],"path":["v1","users","register"]}
      },
      "event":[{"listen":"test","script":{"exec":["pm.test('Status code is 200 via gateway', function () { pm.response.to.have.status(200); });"]}}]
    },
    {
      "name": "Register User - Duplicate Email",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body":{"mode":"raw","raw":"{\"email\": \"test1@example.com\", \"password\": \"Password123\", \"name\": \"Test User\"}"},
        "url":{"raw":"{{USERS_URL}}/v1/users/register","host":["{{USERS_URL}}"],"path":["v1","users","register"]}
      },
      "event":[{"listen":"test","script":{"exec":["pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"]}}]
    },
